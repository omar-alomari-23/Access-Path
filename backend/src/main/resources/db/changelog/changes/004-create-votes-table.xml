<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004" author="accesspath">
        <createTable tableName="votes">
            <column name="vote_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="report_id" type="uuid">
                <constraints nullable="false"
                    foreignKeyName="fk_vote_report"
                    references="reports(report_id)"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"
                    foreignKeyName="fk_vote_user"
                    references="users(user_id)"/>
            </column>
            <column name="vote_type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Prevent duplicate voting -->
        <addUniqueConstraint
            tableName="votes"
            columnNames="user_id, report_id"
            constraintName="uq_vote_user_report"/>

        <rollback>
            <dropTable tableName="votes"/>
        </rollback>
    </changeSet>

</databaseChangeLog>